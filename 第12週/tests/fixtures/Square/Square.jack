class Square {
  field int x, y, size;
  field boolean direction;
  constructor Square new(int Ax, int Ay, int Asize) {
    let x = Ax;
    let y = Ay;
    let size = Asize;
    let direction = true;
    do draw();
    return this;
  }
  method void dispose() { do Memory.deAlloc(this); return; }
  method void draw() { do Screen.setColor(true); do Screen.drawRectangle(x, y, x + size, y + size); return; }
  method void erase() { do Screen.setColor(false); do Screen.drawRectangle(x, y, x + size, y + size); return; }
  method void moveUp() { do erase(); let y = y - 2; do draw(); return; }
}
